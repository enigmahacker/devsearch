# Claude (answers). Leave unset if you use `ant auth login`.
ANTHROPIC_API_KEY=
# Voyage AI (embeddings). Unset = local hash embeddings (dev only, weak semantic recall).
VOYAGE_API_KEY=
# Optional: raise GitHub (60/h -> 5000/h) and Stack Exchange (300/day -> 10k/day) rate limits.
GITHUB_TOKEN=
STACK_KEY=
# Grounded answers each client IP may request per day.
DAILY_ANSWER_CAP=50

# Local docker Postgres, or Supabase: Project → Connect → "Transaction pooler" URI, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_DSN=postgresql://devsearch:devsearch@localhost:5432/devsearch
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# --- Answer models. Visitors add their own provider key in Settings (used per request, never stored).
# Keys here are optional server fallbacks that YOU pay for; leave them empty to require visitor keys.
# <PROVIDER>_MODELS overrides a provider's default model IDs.
ANTHROPIC_MODELS=claude-opus-5-5,claude-fable-5-2,claude-sonnet-5-5,claude-haiku-5-5
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
# Any OpenAI-compatible server (vLLM, Ollama: http://localhost:11434/v1, LiteLLM, Azure...).
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODELS=
DEFAULT_MODEL=anthropic:claude-opus-5-5

# --- Auth. API_TOKEN is shared by api and web; AUTH_* are read by web (Next.js) only.
API_TOKEN=
AUTH_PASSWORD=
AUTH_SECRET=

# --- Rate limits per client IP (Redis). Login attempts are counted by the API for the web app.
RATE_LIMIT_PER_MIN=60
ANSWER_LIMIT_PER_MIN=6
LOGIN_LIMIT_PER_15MIN=10

# --- Web only: Razorpay Payment Page or Payment Link (https://razorpay.me/@you, https://rzp.io/..., https://pages.razorpay.com/...).
# The "Support the developer" button is hidden unless this is a Razorpay https URL.
SUPPORT_URL=
